# ==========================================
# TwinEU AI Models Integration Component .env
# ==========================================

# 1. TwinEU Middleware (Central Federated Catalog)
MIDDLEWARE_URL=http://4.232.76.64/middleware-dev
MIDDLEWARE_USER=your_provider_username
MIDDLEWARE_PASS=your_provider_password

# 2. DSP Connector API (For physical data hosting)
DSP_CONNECTOR_API_URL=https://your-dsp-connector.euprojects.net

# 3. Local Database 
DB_PATH=./data/models.db
LOG_LEVEL=INFO

# 4. Shared Storage (Optional: For BDMM MinIO integration)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1

# 5. Maximum File Size (in bytes) - 500 MB = 500 * 1024 * 1024 = 524288000
MAX_FILE_SIZE_BYTES=524288000

AIMIC_PORT=8100